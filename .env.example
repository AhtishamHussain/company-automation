# =============================================================================
# Master — secrets template
# Copy to .env and fill values. Never commit .env (gitignored).
# Paste tokens here, not in chat. Tell the agent which blocks you filled.
# =============================================================================

# --- Control plane ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 1 = demo fallback if an engine is down; 0 = live-only
MASTER_DEMO_MODE=1

# --- Engines (local docker) ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

KESTRA_BASE_URL=http://localhost:8080
KESTRA_API_TOKEN=
KESTRA_USERNAME=admin@master.local
KESTRA_PASSWORD=MasterKestra1

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_URL=http://localhost:8088
TEMPORAL_BRIDGE_URL=http://localhost:8099

# Recruitment + Support (local webhook runner; docker AP UI is optional on :8081)
ACTIVEPIECES_BASE_URL=http://localhost:8091
ACTIVEPIECES_API_KEY=local

# Meeting + Proposals (local task runner; swap for cloud.trigger.dev later)
TRIGGER_API_URL=http://localhost:8092
TRIGGER_SECRET_KEY=local
TRIGGER_PROJECT_REF=master

# =============================================================================
# WAVE 1 — n8n live (CRM / Email / Slack / WhatsApp / AI)
# =============================================================================

# Slack bot (api.slack.com → Your Apps → OAuth & Permissions)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#ops

# WhatsApp Cloud API (developers.facebook.com → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Email send — fill Resend OR SMTP, not both required
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CRM — fill ONE stack
HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
TWENTY_API_KEY=
TWENTY_BASE_URL=

# AI
OPENAI_API_KEY=

# =============================================================================
# WAVE 2 — other domains (optional until those flows go live)
# =============================================================================

# Stripe (invoices / payment links)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Accounting — pick one
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Object storage (CRM/KB backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Knowledge base
NOTION_TOKEN=
# Google Drive / Gmail / Calendar: OAuth — one Connect click in n8n after seed
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Support — pick one
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Recruitment — pick one
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# Meetings
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# GitHub (bug escalate)
GITHUB_TOKEN=

# OCR (optional if OpenAI is enough)
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=
